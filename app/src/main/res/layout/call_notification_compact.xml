<?xml version="1.0" encoding="utf-8"?>
<!-- CUSTOM_HOOK(call-notification): compact incoming-call view keeps the answer /
     decline buttons visible in the collapsed and heads-up states on HyperOS/MIUI
     (PORTING_FEATURES.md §E4, port of commit 5de48b908) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/compact_root"
  android:layout_width="match_parent"
  android:layout_height="48dp"
  android:layoutDirection="locale"
  android:background="@drawable/call_notification_bg">

  <ImageView
    android:id="@+id/photo"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:layout_alignParentStart="true"
    android:layout_centerVertical="true"
    android:layout_marginStart="8dp" />

  <LinearLayout
    android:id="@+id/buttons"
    android:layout_width="104dp"
    android:layout_height="match_parent"
    android:layout_alignParentEnd="true"
    android:orientation="horizontal">

    <FrameLayout
      android:id="@+id/decline_btn"
      android:layout_width="52dp"
      android:layout_height="match_parent"
      android:background="@drawable/bar_selector_white">

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_call_notification_decline" />
    </FrameLayout>

    <FrameLayout
      android:id="@+id/answer_btn"
      android:layout_width="52dp"
      android:layout_height="match_parent"
      android:background="@drawable/bar_selector_white">

      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_call_notification_answer" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_toEndOf="@id/photo"
    android:layout_toStartOf="@id/buttons"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="4dp"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
      android:id="@+id/name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:singleLine="true"
      android:textColor="#fff"
      android:textSize="15sp" />

    <TextView
      android:id="@+id/title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:textColor="#bfffffff"
      android:textSize="11sp" />
  </LinearLayout>
</RelativeLayout>
