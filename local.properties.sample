## This file must *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the SDK. This is only used by Gradle.
# For customization when using a Version Control System, please read the
# header note.

# Note for Windows: use \\ or / as file path separator.

# Path to Android SDK
sdk.dir=

# Path to the home of rustup with Rust of version.rust of version.properties, see scripts/setup-rust.sh
rust.dir=

# Location of the MSYS2. This is only used on Windows.
msys2.dir=

## Package name
app.id=org.example.tgx

## Project name
app.name=TGX Example

## Link to the app's website. If unavailable, link to the market page could be used.
app.download_url=https://telegram.org/dlx

## Obtain credentials to access Telegram API:
# https://core.telegram.org/api/obtaining_api_id
telegram.api_id=94575
telegram.api_hash=a3406de8d171bb422bb6ddf3bbd800e2

## Extension module to apply. One of: none, unifiedpush
tgx.extension=none

## Fork distribution configuration (PORTING_FEATURES.md §4). Empty = feature off.
## Built-in proxy node: vless://... link, forced when the user has no own proxy (§A1/A2)
custom.node_link=
## "Install ntfy" prompt target page for the UnifiedPush build (§D2)
custom.ntfy_link=
## "TG PRO membership" settings row target link; empty hides the row (§C)
custom.pro_link=
## Default UI language pack id until the user picks one, e.g. zh-hans (§B2/B3). Empty = TGX default.
custom.default_language=